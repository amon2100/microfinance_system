<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.sacco.ui.MembersController" spacing="10">
    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>

    <Label text="Members" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <TableView fx:id="membersTable" prefHeight="280">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="60" />
            <TableColumn fx:id="nameColumn" text="Full Name" prefWidth="160" />
            <TableColumn fx:id="nationalIdColumn" text="National ID" prefWidth="120" />
            <TableColumn fx:id="phoneColumn" text="Phone" prefWidth="120" />
            <TableColumn fx:id="emailColumn" text="Email" prefWidth="160" />
        </columns>
    </TableView>

    <GridPane hgap="8" vgap="8">
        <Label text="Full Name" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="fullNameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="National ID" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="nationalIdField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Phone" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <TextField fx:id="phoneField" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

        <Label text="Email" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
        <TextField fx:id="emailField" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

        <Button text="Add Member" onAction="#handleAddMember" GridPane.rowIndex="2" GridPane.columnIndex="1" />
        <Label fx:id="messageLabel" text="" GridPane.rowIndex="2" GridPane.columnIndex="2" GridPane.columnSpan="2" />
    </GridPane>
</VBox>
