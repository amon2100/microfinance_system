<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.sacco.ui.SavingsController" spacing="10">
    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>

    <Label text="Savings Accounts" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <TableView fx:id="accountsTable" prefHeight="280">
        <columns>
            <TableColumn fx:id="accountNoColumn" text="Account No" prefWidth="140" />
            <TableColumn fx:id="memberColumn" text="Member" prefWidth="200" />
            <TableColumn fx:id="memberIdColumn" text="Member ID" prefWidth="100" />
            <TableColumn fx:id="balanceColumn" text="Balance" prefWidth="120" />
        </columns>
    </TableView>

    <GridPane hgap="8" vgap="8">
        <Label text="Member ID" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="memberIdField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Account No" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="accountNoField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Amount" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <TextField fx:id="amountField" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

        <Button fx:id="createAccountButton" text="Create Account" onAction="#handleCreateAccount" GridPane.rowIndex="2" GridPane.columnIndex="1" />
        <Button fx:id="depositButton" text="Deposit" onAction="#handleDeposit" GridPane.rowIndex="2" GridPane.columnIndex="2" />
        <Button fx:id="withdrawButton" text="Withdraw" onAction="#handleWithdraw" GridPane.rowIndex="2" GridPane.columnIndex="3" />

        <Label fx:id="messageLabel" text="" GridPane.rowIndex="3" GridPane.columnIndex="1" GridPane.columnSpan="3" />
    </GridPane>
</VBox>
