<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.sacco.ui.TransactionsController" spacing="10">
    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>

    <Label text="Transactions" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <TableView fx:id="transactionsTable" prefHeight="320">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="60" />
            <TableColumn fx:id="memberColumn" text="Member" prefWidth="180" />
            <TableColumn fx:id="typeColumn" text="Type" prefWidth="160" />
            <TableColumn fx:id="amountColumn" text="Amount" prefWidth="120" />
            <TableColumn fx:id="createdAtColumn" text="Created At" prefWidth="160" />
        </columns>
    </TableView>

    <GridPane hgap="8" vgap="8">
        <Label text="Transaction ID" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="reversalTransactionIdField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Button fx:id="reverseButton" text="Reverse" onAction="#handleReverse" GridPane.rowIndex="0" GridPane.columnIndex="2" />
        <Label fx:id="messageLabel" text="" GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="2" />
    </GridPane>
</VBox>
