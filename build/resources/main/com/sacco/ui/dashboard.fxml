<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.sacco.ui.DashboardController">
    <top>
        <VBox spacing="6" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="10" right="16" bottom="10" left="16"/>
            </padding>
            <Label text="Dashboard" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Label fx:id="userLabel" text="Logged in as:"/>
        </VBox>
    </top>
    <center>
        <TabPane>
            <Tab text="Members" closable="false">
                <fx:include source="members.fxml" />
            </Tab>
            <Tab text="Savings" closable="false">
                <fx:include source="savings.fxml" />
            </Tab>
            <Tab text="Loans" closable="false">
                <Label text="Loan issuance and repayments" />
            </Tab>
            <Tab text="Transactions" closable="false">
                <Label text="Transaction history" />
            </Tab>
            <Tab text="Audit" closable="false">
                <Label text="Audit log viewer" />
            </Tab>
        </TabPane>
    </center>
</BorderPane>
