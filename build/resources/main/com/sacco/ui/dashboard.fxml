<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.sacco.ui.DashboardController">
    <top>
        <HBox spacing="12" styleClass="topbar" BorderPane.alignment="CENTER_LEFT">
            <Label text="B" styleClass="logo-mark" />
            <Label text="SACCO Microfinance System" styleClass="header" />
            <TextField fx:id="searchField" promptText="Search by name or ID" onAction="#handleSearch" HBox.hgrow="ALWAYS" maxWidth="280" />
            <Button fx:id="searchButton" text="Search" onAction="#handleSearch" />
            <Label fx:id="userLabel" text="Logged in as:" />
            <Label fx:id="statusLabel" text="Offline" styleClass="status-badge" />
        </HBox>
    </top>
    <left>
        <VBox spacing="8" styleClass="sidebar" BorderPane.alignment="TOP_LEFT">
            <StackPane styleClass="profile-frame">
                <Label text="Profile" styleClass="subtle" />
            </StackPane>
            <Label text="Overview" styleClass="subtle" />
            <Button fx:id="membersNav" text="Home" styleClass="nav-button" onAction="#showMembers" />
            <Button fx:id="dataNav" text="Data View" styleClass="nav-button" onAction="#showMembers" />

            <Label text="Operations" styleClass="subtle" />
            <Button fx:id="savingsNav" text="Savings" styleClass="nav-button" onAction="#showSavings" />
            <Button fx:id="loansNav" text="Loans" styleClass="nav-button" onAction="#showLoans" />
            <Button fx:id="transactionsNav" text="Transactions" styleClass="nav-button" onAction="#showTransactions" />
            <Button fx:id="usersNav" text="Users" styleClass="nav-button" onAction="#showUsers" />
            <Button fx:id="auditNav" text="Audit" styleClass="nav-button" onAction="#showAudit" />
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentStack">
            <padding>
                <Insets top="12" right="12" bottom="12" left="12"/>
            </padding>
            <VBox fx:id="membersView" styleClass="content-card">
                <fx:include source="members.fxml" />
            </VBox>
            <VBox fx:id="savingsView" styleClass="content-card" visible="false" managed="false">
                <fx:include source="savings.fxml" />
            </VBox>
            <VBox fx:id="loansView" styleClass="content-card" visible="false" managed="false">
                <fx:include source="loans.fxml" />
            </VBox>
            <VBox fx:id="transactionsView" styleClass="content-card" visible="false" managed="false">
                <fx:include source="transactions.fxml" />
            </VBox>
            <VBox fx:id="usersView" styleClass="content-card" visible="false" managed="false">
                <fx:include source="users.fxml" />
            </VBox>
            <VBox fx:id="auditView" styleClass="content-card" visible="false" managed="false">
                <Label text="Audit log viewer" />
            </VBox>
        </StackPane>
    </center>
</BorderPane>
